--- !u!114 &3597421639689293412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7221566990125668715}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a138ff787480c584eb66c1059156f442, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  NPCPanel: {fileID: 4767959351793508998}
  NPCName: {fileID: 7434736461589509891}
  NPCContent: {fileID: 3186947991394180884}
  names:
  - "Tr\u01B0\u1EDFng Th\xF4n"
  - "Tr\u01B0\u1EDFng Th\xF4n"
  - "Tr\u01B0\u1EDFng Th\xF4n"
  - "Tr\u01B0\u1EDFng Th\xF4n"
  - "Ng\u01B0\u1EDDi ch\u01A1i"
  - "Tr\u01B0\u1EDFng Th\xF4n"
  - "Ng\u01B0\u1EDDi ch\u01A1i"
  - "Tr\u01B0\u1EDFng Th\xF4n"
  content:
  - "Ng\u01B0\u01A1i\u2026 kh\xF4ng n\xEAn \u1EDF \u0111\xE2y\u2026 R\u1EDDi \u0111i
    khi c\xF2n c\xF3 th\u1EC3!"
  - "Tr\u01B0\u1EDBc m\u1EAFt ng\u01B0\u01A1i l\xE0 m\u1ED9t th\u1EBF gi\u1EDBi ph\u1EE7
    \u0111\u1EA7y b\u0103ng tuy\u1EBFt"
  - "N\u01A1i nh\u1EEFng ng\u1ECDn n\xFAi kh\u1ED5ng l\u1ED3 v\u01B0\u01A1n cao ch\u1EA1m
    t\u1EDBi b\u1EA7u tr\u1EDDi, v\xE0 nh\u1EEFng t\xF2a th\xE0nh c\u1ED5 \u0111\u1EA1i
    n\u1EB1m \u1EA9n m\xECnh d\u01B0\u1EDBi l\u1EDBp tuy\u1EBFt d\xE0y"
  - "\u0110\xE2y t\u1EEBng l\xE0 m\u1ED9t v\u01B0\u01A1ng qu\u1ED1c th\u1ECBnh v\u01B0\u1EE3ng,
    nh\u01B0ng gi\u1EDD ch\u1EC9 c\xF2n l\u1EA1i nh\u1EEFng chi\u1EBFn binh b\u1ECB
    \u0111\xF3ng b\u0103ng,"
  - "Nh\u1EEFng con qu\xE1i v\u1EADt b\u0103ng kh\u1ED5ng l\u1ED3 lang thang trong
    gi\xE1 r\xE9t"
  - "Ng\u01B0\u01A1i \u0111ang t\xECm ki\u1EBFm m\u1EA3nh gh\xE9p c\u1ED5 \u0111\u1EA1i
    \u01B0?"
  - "N\xF3 n\u1EB1m trong tay Vua B\u0103ng Gi\xE1"
  - "K\u1EBB \u0111\xE3 b\u1ECB nguy\u1EC1n r\u1EE7a v\u0129nh vi\u1EC5n trong th\xE0nh
    tr\xEC kia"
  - "Nh\u01B0ng h\xE3y c\u1EA9n th\u1EADn, v\xEC ng\xE0i \u1EA5y kh\xF4ng c\xF2n
    l\xE0 con ng\u01B0\u1EDDi n\u1EEFa\u2026"
  buttonBG: {fileID: 8245920447004454080}
  quitButton: {fileID: 4208994975242057386}
  startEventButton: {fileID: 8088268823823751544}
  evenGameObject: {fileID: 5587187912258896831}
